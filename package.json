{
  "name": "playhouse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0",
    "server": "node server/index.js",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/game.test.mjs src/audio.test.mjs server/server.test.js"
  },
  "dependencies": {
    "ethers": "^6.15.0",
    "pg": "^8.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
